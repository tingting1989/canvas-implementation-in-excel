{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "declaration": false,
        "declarationDir": null,
        "emitDeclarationOnly": false,
        "noEmit": true,
        "rootDir": ".",
        "types": ["vitest/globals"],
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.js",
        "src/**/*.d.ts",
        "tests/**/*.test.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}